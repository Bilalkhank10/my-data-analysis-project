# --- GigCraft server configuration ---

# Password required to log into the studio/lab. REQUIRED in production.
# If unset, the server generates a random temporary password and prints it to
# the server log on boot (do not rely on that for real deployments).
APP_PASSWORD=change-me-to-a-strong-password

# Secret used to sign auth tokens (HMAC-SHA256). If unset, a random one is
# generated per boot (which invalidates existing tokens on restart).
AUTH_SECRET=

# Port the HTTP server listens on (default 3000).
PORT=3000

# Google Gemini API key used for AI gig generation. When unset, the server
# still runs and falls back to a deterministic local draft template.
GEMINI_API_KEY=

# --- Live Fiverr crawler (Jina Reader proxy) ---
# Live gig data is fetched through the public r.jina.ai reader proxy (no Fiverr
# account needed). When it is unreachable/blocked, the app falls back to a
# clearly-labelled illustrative sample. Set to false to disable live crawling.
ALLOW_READER_FALLBACK=true
MAX_CONCURRENCY=2
REQUEST_DELAY_SECONDS=2.0
MAX_SEARCH_PAGES=5
SEARCH_PAGE_DELAY_SECONDS=0.75
RETRY_COUNT=3
RETRY_BASE_DELAY_SECONDS=1.0
READER_TIMEOUT_SECONDS=60

# --- OpenRouter (used by the Python niche-fetcher AI services; optional) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_DEEP_MODEL=
OPENROUTER_EMBEDDING_MODEL=
OPENROUTER_TIMEOUT_SECONDS=
OPENROUTER_MAX_OUTPUT_TOKENS=
OPENROUTER_MAX_COST_USD=
OPENROUTER_MAX_GIGS=
OPENROUTER_GIGS_PER_BATCH=
OPENROUTER_ALLOW_PARAMETER_FALLBACK=

# --- Python sibling services launch options (optional) ---
HOST=
AUTO_FIND_PORT=
AUTO_OPEN_BROWSER=
MAX_ACTIVE_JOBS=
