# --- GigCraft server (TypeScript app, root) ---

# Password required to log into the studio/lab. REQUIRED in production.
# If unset, the server generates a random temporary password and prints it
# to the server log on boot (do not rely on that for real deployments).
# The SAME variable protects the Python app (fiverr-niche-fetcher/app.py).
APP_PASSWORD=change-me-to-a-strong-password

# Secret used to sign auth tokens (HMAC-SHA256) AND download URLs.
# If unset, a random one is generated per boot (invalidates tokens/links on
# restart).
AUTH_SECRET=

# Port the HTTP server listens on (default 3000).
PORT=3000

# Google Gemini API key used for AI gig generation + semantic audits in the
# TypeScript app. When unset, the server still runs and falls back to a
# clearly-labelled deterministic local template (no cost, no fake tokens).
GEMINI_API_KEY=

# --- Live Fiverr crawler (Jina Reader proxy) ---
# Live gig data is fetched through the public r.jina.ai reader proxy (no
# Fiverr account needed). When it is unreachable/blocked, the app falls back
# to a clearly-labelled illustrative sample. Set to false to disable live
# crawling.
ALLOW_READER_FALLBACK=true
# OPTIONAL but strongly recommended: a FREE Jina API key raises the rate
# limit from ~20 RPM (keyless) to ~500 RPM and adds 10M free tokens.
JINA_API_KEY=
MAX_CONCURRENCY=2
REQUEST_DELAY_SECONDS=2.0
MAX_SEARCH_PAGES=5
SEARCH_PAGE_DELAY_SECONDS=0.75
RETRY_COUNT=3
RETRY_BASE_DELAY_SECONDS=1.0
READER_TIMEOUT_SECONDS=60

# --- Crawl cache & storage (TypeScript app) ---
# Reader responses are cached in data/gigcraft.db for this many seconds to
# avoid re-hitting Jina when re-crawling the same niche.
CRAWL_CACHE_TTL_SECONDS=21600
# Maximum number of jobs kept in memory/DB (oldest finished jobs are evicted).
MAX_JOBS=50
# Where runtime data lives (default: <cwd>/data).
# DATA_DIR=

# --- Rate limiting (TypeScript app) ---
# Requests per IP per 15 minutes allowed on /api/auth/login (brute-force guard).
LOGIN_RATE_LIMIT_MAX=8
# Requests per IP per minute allowed on the rest of /api.
API_RATE_LIMIT_MAX=600

# --- Python sibling (fiverr-niche-fetcher) AI services; optional ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_DEEP_MODEL=
OPENROUTER_EMBEDDING_MODEL=
OPENROUTER_TIMEOUT_SECONDS=
OPENROUTER_MAX_OUTPUT_TOKENS=
OPENROUTER_MAX_COST_USD=
OPENROUTER_MAX_GIGS=
OPENROUTER_GIGS_PER_BATCH=
OPENROUTER_ALLOW_PARAMETER_FALLBACK=
# OPTIONAL: paid Firecrawl route for the Python crawler. When set, the
# crawler uses api.firecrawl.dev; otherwise it uses the Jina Reader route.
FIRECRAWL_API_KEY=

# --- Python sibling services launch options (optional) ---
HOST=
AUTO_FIND_PORT=
AUTO_OPEN_BROWSER=
MAX_ACTIVE_JOBS=
