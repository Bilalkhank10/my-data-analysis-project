{
  "mcpServers": {
    "fiverr-niche-fetcher": {
      "type": "stdio",
      "command": "python",
      "args": [
        "REPLACE_WITH_FULL_PATH/mcp_server.py"
      ],
      "env": {
        "PYTHONPATH": "REPLACE_WITH_FULL_PATH",
        "ALLOW_READER_FALLBACK": "true",
        "MAX_CONCURRENCY": "2",
        "REQUEST_DELAY_SECONDS": "2.0",
        "MAX_SEARCH_PAGES": "10",
        "SEARCH_PAGE_DELAY_SECONDS": "0.75",
        "RETRY_COUNT": "3",
        "RETRY_BASE_DELAY_SECONDS": "1.0",
        "READER_TIMEOUT_SECONDS": "90"
      }
    }
  }
}
