# Local server
HOST=127.0.0.1
PORT=8000
AUTO_FIND_PORT=true
AUTO_OPEN_BROWSER=true

# Phase 1 crawl controls. Keep values respectful and low.
MAX_ACTIVE_JOBS=1
MAX_CONCURRENCY=2
REQUEST_DELAY_SECONDS=2.0

# Search pagination (500 gigs may require many pages).
MAX_SEARCH_PAGES=30
SEARCH_PAGE_DELAY_SECONDS=0.75

# Network retry policy.
RETRY_COUNT=3
RETRY_BASE_DELAY_SECONDS=1.0
READER_TIMEOUT_SECONDS=90

# Public URLs are sent to the third-party Jina Reader service.
ALLOW_READER_FALLBACK=true

# Phase 3 — create a NEW rotated OpenRouter key and set it locally.
# Never commit or paste the real value into chat/source control.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.7-flash
OPENROUTER_EMBEDDING_MODEL=google/gemini-embedding-001
OPENROUTER_DEEP_MODEL=anthropic/claude-sonnet-5
OPENROUTER_MAX_COST_USD=2.00
OPENROUTER_MAX_GIGS=25
OPENROUTER_GIGS_PER_BATCH=1
OPENROUTER_MAX_OUTPUT_TOKENS=4000
OPENROUTER_TIMEOUT_SECONDS=120
OPENROUTER_ALLOW_PARAMETER_FALLBACK=true
